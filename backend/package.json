{
  "name": "fitbite-backend",
  "version": "1.0.0",
  "description": "FitBite Core Backend - Node.js, Express, MySQL & Socket.IO",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "seed": "node src/db/seedRunner.js",
    "test": "node --test --test-concurrency=1 test/**/*.test.js"
  },
  "keywords": ["food-delivery", "tiffin", "meal-planner", "express", "mysql"],
  "author": "FitBite Engineering",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "socket.io": "^4.8.1"
  }
}
