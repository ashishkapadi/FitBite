# ==============================================================================
# FitBite Backend Environment Configuration (.env.example)
# Node.js Express API & Long-Running Services
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=production

# CORS Allowed Origins (Comma-separated list of permitted frontend URLs)
# Note: Vercel preview URLs (*.vercel.app) are also matched dynamically
CLIENT_URL=https://fitbite.vercel.app
ALLOWED_ORIGINS=https://fitbite.vercel.app,https://fitbite-production.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# Managed MySQL Database Connection
# ------------------------------------------------------------------------------
# Use DATABASE_URL if provided by your host (Railway, PlanetScale, Render, TiDB):
# DATABASE_URL=mysql://user:password@host.railway.app:3306/railway?ssl=true

# Or discrete connection parameters:
DB_HOST=mysql.your-cloud-host.internal
DB_PORT=3306
DB_USER=fitbite_app
DB_PASSWORD=your_strong_mysql_password_here
DB_NAME=fitbite_db
DB_SSL=false
DB_POOL_LIMIT=10
DB_CONNECT_TIMEOUT=10000

# Set to true only in local dev if MySQL is unavailable.
# In production, keep false to guarantee data is stored in managed MySQL.
ENABLE_LOCAL_JSON_FALLBACK=false

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Generate a cryptographically random secret with: openssl rand -base64 32
JWT_SECRET=replace_with_strong_random_jwt_secret_64_characters_min
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Java / Spring Boot Meal Planner Microservice
# ------------------------------------------------------------------------------
# Internal private service URL on Render, Railway, or Docker network
JAVA_MEAL_PLANNER_URL=http://fitbite-meal-planner:8082
JAVA_PLANNER_URL=http://fitbite-meal-planner:8082

# ------------------------------------------------------------------------------
# Persistent Object Storage (Food Images & Seller Compliance Documents)
# ------------------------------------------------------------------------------
# Options: 's3' (AWS S3, Cloudflare R2, MinIO) or 'local' (mounted persistent disk volume)
STORAGE_PROVIDER=local
UPLOADS_DIR=/var/data/uploads

# If using S3 / Cloudflare R2:
# STORAGE_PROVIDER=s3
# S3_BUCKET_NAME=fitbite-assets-production
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# S3_REGION=ap-south-1
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_PUBLIC_URL=https://cdn.fitbite.app

# ------------------------------------------------------------------------------
# Payment Gateway & Webhook Verification
# ------------------------------------------------------------------------------
# Options: 'demo' (interactive simulation) or 'live'
PAYMENT_PROVIDER_MODE=demo

# Required ONLY when PAYMENT_PROVIDER_MODE=live:
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Email & SMS OTP Delivery (Optional)
# ------------------------------------------------------------------------------
NOTIFICATION_PROVIDER_MODE=demo
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_sendgrid_api_key
