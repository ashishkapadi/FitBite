# ==============================================================================
# FitBite Java Spring Boot Meal Planner Service Environment Configuration
# ==============================================================================

# Server Port (Injected automatically by Render/Railway/Heroku via $PORT)
PORT=8082

# JVM Options (Adjust memory for small PaaS instances, e.g. 512MB RAM)
JAVA_OPTS=-Xmx384m -Xms128m

# Rule Engine Configuration
FITBITE_PLANNER_RULES_ENABLED=true
