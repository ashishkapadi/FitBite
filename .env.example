# ==============================================================================
# FitBite Complete Full-Stack Environment Template (.env.example)
# Architecture: React (Vercel) + Node.js (Render/Railway) + Java 17 + Managed MySQL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend (Vercel) Environment Variables
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=https://api.fitbite.app/api
VITE_SOCKET_URL=https://api.fitbite.app
VITE_MAPS_DEMO_KEY=demo_preview_mode

# ------------------------------------------------------------------------------
# 2. Node.js Backend API (Render / Railway / Docker host)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
CLIENT_URL=https://fitbite.vercel.app
ALLOWED_ORIGINS=https://fitbite.vercel.app,https://fitbite-production.vercel.app,http://localhost:5173

# Managed MySQL Database Connection
# If provider supplies a connection string:
# DATABASE_URL=mysql://user:password@mysql.host.provider:3306/fitbite_db?ssl=true
DB_HOST=mysql.host.internal
DB_PORT=3306
DB_USER=fitbite_user
DB_PASSWORD=your_secure_mysql_password
DB_NAME=fitbite_db
DB_SSL=true
DB_POOL_LIMIT=10
ENABLE_LOCAL_JSON_FALLBACK=false

# Authentication & Security
JWT_SECRET=generate_strong_64_character_random_string_for_production
JWT_EXPIRES_IN=7d

# Microservice: Java Spring Boot Meal Planner
JAVA_MEAL_PLANNER_URL=http://fitbite-meal-planner:8082
JAVA_PLANNER_URL=http://fitbite-meal-planner:8082

# Persistent Object Storage (Images & Documents)
STORAGE_PROVIDER=local
UPLOADS_DIR=/var/data/uploads
# For S3 / Cloudflare R2:
# STORAGE_PROVIDER=s3
# S3_BUCKET_NAME=fitbite-assets-production
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_REGION=ap-south-1
# STORAGE_PUBLIC_URL=https://cdn.fitbite.app

# Payment Gateway & Webhook Signature Verification
PAYMENT_PROVIDER_MODE=demo
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 3. Java Spring Boot Meal Planner Microservice
# ------------------------------------------------------------------------------
# PORT=8082
# JAVA_OPTS=-Xmx384m -Xms128m
# FITBITE_PLANNER_RULES_ENABLED=true
